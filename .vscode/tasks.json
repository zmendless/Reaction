{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build & Run (raylib)",
      "type": "shell",
      "command": "mkdir -p build && gcc -std=c99 -Wall -Wextra -O3 -march=native -fopenmp -g *.c -o build/ball -I/usr/local/include -L/usr/local/lib -lraylib -lGL -lm -lpthread -ldl -lrt -lX11 && ./build/ball",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "clear": true }
    }
  ]
}
